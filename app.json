{
  "expo": {
    "name": "starbrew-cafe",
    "slug": "starbrew-cafe",
    "scheme": "starbrew-cafe",
    "version": "1.0.0",
    "updates": {
      "enabled": false
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6B3F2A",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.kaigosamasteam.starbrewcafe",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StarBrew Cafe to access your camera to scan order QR codes."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5f01559-9b16-4eb2-bdcc-2810890d9a7e"
      }
    },
    "owner": "kaigosamas-team"
  }
}
